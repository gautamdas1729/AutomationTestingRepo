pipeline {
    agent any

    parameters {
        choice(name: 'ENV', choices: ['QA', 'DEV', 'UAT'], description: 'Environment')
        choice(name: 'BROWSER', choices: ['Chrome', 'Edge', 'Firefox'], description: 'Browser')
    }

    stages {
        stage('Test') {
            steps {
                bat "mvn clean test -Denv=${params.ENV} -Dbrowser=${params.BROWSER}"
            }
        }
    }
    post{
     always{
        echo 'Test execution completed'
     }
     success{
        echo 'Automation tests PASSED'
     }
     failure{
        echo 'Automation tests failed'
     }

    }
}
